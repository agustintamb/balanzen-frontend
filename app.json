{
  "expo": {
    "name": "balanzen-frontend",
    "slug": "balanzen-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "balanzenfrontend",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.anonymous.balanzenfrontend"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/balanzen-logo.png",
          "imageWidth": 192,
          "resizeMode": "contain",
          "backgroundColor": "#1A3408"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BalanZen usa tu ubicación para mostrarte publicaciones cercanas y ayudarte a confirmar tu dirección.",
          "locationAlwaysAndWhenInUsePermission": "BalanZen usa tu ubicación para mostrarte publicaciones cercanas y ayudarte a confirmar tu dirección."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiLocalPort": "3001",
      "apiLocalDeviceUrl": "",
      "appEnv": "local",
      "router": {},
      "eas": {
        "projectId": "9266f216-c58a-4ae6-9997-323ab3c03c30"
      }
    },
    "owner": "agustintamb"
  }
}
