API_LOCAL_PORT=3001

# Google Maps API Key — requerida para el mapa en Android (emulador y dispositivo físico)
# 1. Crear proyecto en: https://console.cloud.google.com/
# 2. Habilitar: Maps SDK for Android
# 3. Crear credencial tipo API Key y pegarla acá
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here


# Obtené tu IP -> Solo necesario si usás un dispositivo físico (no emulador):
# hostname -I | awk '{print $1}'   # Linux
# ipconfig getifaddr en0           # macOS
# ipconfig | findstr IPv4          # Windows
# API_LOCAL_DEVICE_URL=http://192.168.x.x:3001/api/v1